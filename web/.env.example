# 팀 공유 입장 암호
SITE_PASSWORD=change-me

# 쿠키 서명 비밀키 (아무 긴 랜덤 문자열)
AUTH_SECRET=generate-a-long-random-string

# 외부 Agent용 Bearer 토큰 (MCP·REST 공용)
AGENT_API_TOKEN=generate-another-long-random-string

# Q&A용 Anthropic API 키 (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Q&A 일일 호출 상한 (선택, 기본 200)
QA_DAILY_LIMIT=200
