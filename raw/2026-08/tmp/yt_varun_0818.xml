  <title>How I Manage Projects End To End (1 Hour Masterclass)</title>
  <link rel="alternate" href="https://www.youtube.com/watch?v=mwQhnZ32CeE"/>
  <author>
   <name>Varun Mayya</name>
   <uri>https://www.youtube.com/channel/UCsQoiOrh7jzKmE8NBofhTnQ</uri>
